{
  "manifest_version": 3,
  "name": "Indeed Job Ad Copier",
  "version": "1.0.0",
  "description": "One click copies an Indeed job ad — title, company, details and full description — as clean text.",
  "permissions": ["activeTab", "scripting"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Copy this job ad", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Copy this job ad"
    }
  }
}
